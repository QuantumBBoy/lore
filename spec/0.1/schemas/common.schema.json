{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantumbboy.github.io/lore/spec/0.1/common.schema.json",
  "title": "Lore 0.1 common definitions",
  "description": "Shared value types for Lore 0.1 frontmatter. See spec/SPEC.md, section 5.",
  "$defs": {
    "version": {
      "description": "Lore spec version the folder conforms to. A quoted string.",
      "const": "0.1"
    },
    "level": {
      "description": "Sensitivity level. Absent means private.",
      "enum": [
        "public",
        "private",
        "sensitive"
      ]
    },
    "fullDate": {
      "description": "Calendar date YYYY-MM-DD (ISO 8601).",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-9]))$",
      "format": "date"
    },
    "yearlessDate": {
      "description": "Month and day without a year, --MM-DD (ISO 8601 / vCard). --02-29 is valid.",
      "type": "string",
      "pattern": "^--(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-9]))$"
    },
    "personDate": {
      "description": "A full date or a yearless date.",
      "anyOf": [
        {
          "$ref": "#/$defs/fullDate"
        },
        {
          "$ref": "#/$defs/yearlessDate"
        }
      ]
    },
    "entryDate": {
      "description": "Date that starts a body entry: YYYY-MM-DD, YYYY-MM or YYYY.",
      "type": "string",
      "pattern": "^[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?$"
    },
    "dateTime": {
      "description": "RFC 3339 date-time in UTC, e.g. 2026-10-13T16:00:00Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "format": "date-time"
    },
    "cadence": {
      "description": "Desired interval: a positive number and a unit, d (days), w (weeks), m (months) or y (years). Examples: 10d, 2w, 1m, 1y.",
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}[dwmy]$"
    },
    "slug": {
      "description": "File name of a person without .md: lowercase ASCII letters and digits in hyphen-separated groups.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "description": "Display name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "aliases": {
      "description": "Other names: nicknames, diminutives, spellings.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true
    },
    "language": {
      "description": "BCP 47 language tag, e.g. es, en-GB.",
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "timezone": {
      "description": "IANA time zone name, e.g. Europe/Madrid.",
      "type": "string",
      "pattern": "^(?:UTC|[A-Za-z]+(?:/[A-Za-z0-9_+-]+)+)$"
    },
    "extensionKey": {
      "description": "Extension field: <namespace>.<field>. The namespace is everything before the last dot.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9_-]*)+$"
    }
  }
}
